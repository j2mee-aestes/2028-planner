# 보통은 필요 없음: Firebase 설정은 src/config.ts 에 들어 있음.
# 다른 Firebase 프로젝트를 쓰거나 값을 덮어쓸 때만 아래를 채워 .env 로 저장.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_ALLOWED_EMAIL=
# 1 이면 Firebase 없이 이 브라우저에만 저장 (테스트용)
VITE_LOCAL_MODE=
